# fantasyvps (2 ГБ RAM, рядом стек fantasy): по одной загрузке за раз.
# Лимит одного файла 2000 MiB — потолок загрузки ботом в Telegram.
YTDLP_MAX_FILESIZE_BYTES=2097152000
MAX_SIMULTANEOUS_DOWNLOADS=1
# Качество видео выбирает пользователь кнопками в боте. Принудительный 360p для
# длинных роликов (только задачи без выбора, напр. из API): YTDLP_LONG_VIDEO_SECONDS=600

# Bunkr CDN (prxp-b.cdn.cr) блокирует датацентровые IP. Residential SOCKS:
# BUNKR_CDN_PROXY=socks5h://user:pass@host:port
